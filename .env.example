# Copia este archivo a `.env` (no se versiona) y ajusta el valor.

# ══════════════════════════════════════════════════════════════════════════════
# App
# ══════════════════════════════════════════════════════════════════════════════
# Entorno de despliegue: development | staging | production. OBLIGATORIO en cualquier despliegue (NODE_ENV=production): staging y producción son
# ambos NODE_ENV=production y solo APP_ENV los distingue. Con `staging`: TODO el sitio es noindex (cabecera, robots.txt y sitemap vacío), solo se
# aceptan claves de PRUEBA (Clerk/Stripe) y no puede usar el dominio de producción. Se lee AL BUILD y al arrancar: debe ser igual en ambos.
# APP_ENV=development
# URL pública base del sitio (metadatos y enlaces para compartir). Se fija al BUILD.
# Desarrollo: http://localhost:3000 · Staging: https://staging.hiloluna.com (o la URL temporal del proveedor) · Producción: https://hiloluna.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nivel mínimo del registro del servidor: info | warn | error (por defecto: info; en pruebas, error). Los registros son JSON de una línea y
# nunca incluyen secretos, tokens de invitación, correos, teléfonos ni mensajes/respuestas de RSVP.
# LOG_LEVEL=info

# CSP (Content-Security-Policy): por defecto se APLICA. Para diagnosticar en staging sin bloquear nada: CSP_REPORT_ONLY=true (envía la política
# como Report-Only). Ver docs/DEPLOYMENT.md §CSP.
# CSP_REPORT_ONLY=

# ══════════════════════════════════════════════════════════════════════════════
# Base de datos
# ══════════════════════════════════════════════════════════════════════════════
# PostgreSQL (Prisma). Sin esta variable la aplicación usa los datos de demostración en memoria
# (solo lectura); con ella lee y escribe en la base de datos. No incluyas credenciales reales aquí.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/hiloluna?schema=public"

# ══════════════════════════════════════════════════════════════════════════════
# Clerk
# ══════════════════════════════════════════════════════════════════════════════
# Clerk (identidad y sesiones). Créalas en https://dashboard.clerk.com → tu aplicación → API keys.
# Sin estas dos claves la aplicación no autentica: en desarrollo el panel abre con el usuario demo
# (modo de demostración) y en cualquier otro entorno las rutas privadas no son accesibles.
# La clave secreta es SOLO de servidor: nunca la expongas en el navegador ni la subas al repositorio.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Opcional: desactiva la telemetría de Clerk en instancias de desarrollo.
# CLERK_TELEMETRY_DISABLED=1

# ══════════════════════════════════════════════════════════════════════════════
# R2 / Almacenamiento de imágenes (S3 compatible)
# ══════════════════════════════════════════════════════════════════════════════
# Almacenamiento de imágenes (S3 compatible: Cloudflare R2 en producción; MinIO/otro en desarrollo).
# Sin estas variables las subidas se DESACTIVAN con un mensaje claro en el editor (no se escribe en /public ni se
# finge que algo se guardó); la invitación de demostración sigue funcionando con sus imágenes de la plantilla.
# Todas son SOLO de servidor: la clave secreta nunca llega al navegador. No subas valores reales al repositorio.
#   S3_ENDPOINT            R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION              R2: auto
#   S3_BUCKET              nombre del bucket (p. ej. hiloluna-media)
#   S3_ACCESS_KEY_ID       token de API de R2 con permisos de Object Read & Write SOLO sobre ese bucket
#   S3_SECRET_ACCESS_KEY   secreto de ese token
#   S3_PUBLIC_BASE_URL     base pública de lectura: dominio personalizado del bucket (p. ej. https://media.hiloluna.com)
#                          o el dominio público r2.dev. Sin barra final. Ver docs/DATABASE_SCHEMA.md §14.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ══════════════════════════════════════════════════════════════════════════════
# Stripe
# ══════════════════════════════════════════════════════════════════════════════
# Compras por evento (Stripe, D-32: UN pago único por evento, sin mensualidades). Todas son SOLO de servidor salvo la clave pública. Sin
# `STRIPE_SECRET_KEY` la aplicación funciona con todos los eventos en plan Gratis, /pricing se muestra y el pago responde «Los pagos
# todavía no están configurados en este entorno.». No subas valores reales al repositorio. Desarrollo = claves `sk_test_…` / `pk_test_…`
# y precios del MODO DE PRUEBA; producción = claves `sk_live_…` / `pk_live_…` y precios del modo real (no los mezcles: la app avisa si las
# claves son de modos distintos). Los importes de referencia (499 / 799 MXN) viven en `lib/billing/plans.ts`: el webhook rechaza
# cualquier cobro cuyo importe o moneda no coincida.
#   STRIPE_SECRET_KEY                    Dashboard → Desarrolladores → Claves de API → Clave secreta.
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY   Clave publicable (solo se usa para comprobar que coincide el modo con la secreta).
#   STRIPE_WEBHOOK_SECRET                `whsec_…` del endpoint de webhook (o el que imprime `stripe listen` en local). Obligatorio para
#                                        cobrar: sin él no se podrían activar los planes después del pago.
#   STRIPE_PRICE_ESSENTIAL_ONE_TIME      `price_…` del precio de PAGO ÚNICO (no recurrente) «Esencial» (499 MXN).
#   STRIPE_PRICE_PREMIUM_ONE_TIME        `price_…` del precio de PAGO ÚNICO «Premium» (799 MXN).
#   STRIPE_PRICE_ESSENTIAL_TO_PREMIUM    `price_…` del precio de PAGO ÚNICO de la mejora Esencial → Premium (la DIFERENCIA: 300 MXN).
# Las variables mensuales anteriores (`STRIPE_PRICE_ESSENTIAL_MONTHLY`, `STRIPE_PRICE_PREMIUM_MONTHLY`) YA NO SE USAN: puedes borrarlas de tu `.env`.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_ONE_TIME=
STRIPE_PRICE_PREMIUM_ONE_TIME=
STRIPE_PRICE_ESSENTIAL_TO_PREMIUM=

# ══════════════════════════════════════════════════════════════════════════════
# Límite de tasa (proveedor externo, opcional en desarrollo)
# ══════════════════════════════════════════════════════════════════════════════
# Proveedor de límite de tasa compartido entre instancias (API REST compatible con Upstash Redis: comandos INCR/EXPIRE/TTL en /pipeline).
# Protege el envío de RSVP, la consulta de enlaces de invitado (?guest=) y la emisión de URLs de subida de imágenes. El webhook de Stripe NO se limita.
# Sin proveedor la app funciona (en desarrollo no hace falta) pero, en PRODUCCIÓN, el arranque lo avisa claramente. Con RATE_LIMIT_REQUIRED=true
# el arranque FALLA si falta. No se usa ningún límite en memoria a propósito (no protege con varias instancias). Ver docs/DEPLOYMENT.md §Límite de tasa.
#   RATE_LIMIT_REST_URL     URL REST del Redis (p. ej. https://<instancia>.upstash.io). Sin barra final.
#   RATE_LIMIT_REST_TOKEN   Token de esa API (solo servidor).
#   RATE_LIMIT_REQUIRED     true = exigir el proveedor en producción (recomendado).
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# RATE_LIMIT_REQUIRED=true
